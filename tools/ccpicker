#!/bin/sh
# Prefer zig cc when installed and runnable; otherwise honor $CC, then system cc.
# cc-rs passes --target=<rust-triple> (e.g. x86_64-unknown-linux-musl), which zig
# rejects because it parses the "unknown" vendor as the OS. So we strip that flag
# and re-add the target in zig's own form (x86_64-linux-musl).

if command -v zig >/dev/null 2>&1 && zig cc --version >/dev/null 2>&1; then
	target=
	n=$#
	i=0
	while [ "$i" -lt "$n" ]; do
		a=$1
		shift
		case $a in
			--target=*) target=${a#--target=} ;;
			*) set -- "$@" "$a" ;;
		esac
		i=$((i + 1))
	done
	if [ -n "$target" ]; then
		exec zig cc -target "$(printf %s "$target" | sed 's/-unknown-/-/')" "$@"
	fi
	exec zig cc "$@"
fi

exec "${CC:-cc}" "$@"
